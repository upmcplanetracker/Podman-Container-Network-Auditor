#!/bin/bash
set -u

# ── Colors & Config ───────────────────────────────────────────
RED='\033[1;91m'
GREEN='\033[1;92m'
BLUE='\033[1;94m'
PURPLE='\033[1;95m'
YELLOW='\033[1;93m'
GRAY='\033[0;90m'
NC='\033[0m'

SHOW_SUMMARY=false
TARGET_CONTAINER=""

# ── Argument parsing ──────────────────────────────────────────
if [[ "${1:-}" == "--summary" ]]; then
    SHOW_SUMMARY=true
elif [[ -n "${1:-}" ]]; then
    TARGET_CONTAINER="$1"
fi

if [ "$SHOW_SUMMARY" = true ]; then
    echo "Generating summary..."
fi

# ── Counters ──────────────────────────────────────────────────
dual_count=0
v6_count=0
v4_count=0
none_count=0
hostnet_count=0
total_running=0

# ── Helper: convert /proc/net/tcp hex IP to readable form ────
decode_ip() {
    local hex=$1
    if [ ${#hex} -eq 8 ]; then
        # IPv4: little-endian bytes → dotted quad
        printf "%d.%d.%d.%d" \
            $((16#${hex:6:2})) $((16#${hex:4:2})) \
            $((16#${hex:2:2})) $((16#${hex:0:2}))
    elif [ ${#hex} -eq 32 ]; then
        # IPv6: for readability just show a placeholder
        echo "[IPv6]"
    else
        echo "???"
    fi
}

# ── Table header (if not summary‑only) ────────────────────────
if [ "$SHOW_SUMMARY" = false ]; then
    printf "${GRAY}%-22s %-12s %s${NC}\n" "Container" "Network" "Listeners (Host Mapping)"
    printf "${GRAY}%s${NC}\n" "--------------------------------------------------------------------------------"
fi

# ── Build container list command ──────────────────────────────
if [ -n "$TARGET_CONTAINER" ] && [ "$SHOW_SUMMARY" = false ]; then
    # Correct quoting: the whole filter value must be one argument
    PS_CMD=(podman ps --filter "name=^${TARGET_CONTAINER}$" --format '{{.ID}} {{.Names}}')
else
    PS_CMD=(podman ps --format '{{.ID}} {{.Names}}')
fi

# ── Main loop ─────────────────────────────────────────────────
while read -r cid name; do
    pid=$(podman inspect "$cid" --format '{{.State.Pid}}' 2>/dev/null)
    [ -z "$pid" ] || [ "$pid" == "0" ] && continue
    ((total_running++))

    # Port mappings from Podman (for display)
    mappings=$(podman inspect "$cid" --format \
        '{{range $p, $conf := .NetworkSettings.Ports}}{{if $conf}}{{range $conf}}{{$p}}:{{.HostPort}} {{end}}{{end}}{{end}}' 2>/dev/null)

    net_mode=$(podman inspect "$cid" --format '{{.HostConfig.NetworkMode}}' 2>/dev/null)

    # ── Host‑network containers share the host stack ──
    if [ "$net_mode" == "host" ]; then
        ((hostnet_count++))
        if [ "$SHOW_SUMMARY" = false ]; then
            printf "${YELLOW}[H]${NC} %-22s %-12s %s\n" \
                "$name" "host" "(host network - see system sockets)"
        fi
        continue
    fi

    # ── Read listening TCP sockets from /proc ─────────────────
    v4_active=$(awk 'NR>1 && $4=="0A" {
        split($2,a,":");
        printf "%s:%d\n", a[1], strtonum("0x"a[2])
    }' "/proc/$pid/net/tcp" 2>/dev/null | sort -u)

    v6_active=$(awk 'NR>1 && $4=="0A" {
        split($2,a,":");
        printf "%s:%d\n", a[1], strtonum("0x"a[2])
    }' "/proc/$pid/net/tcp6" 2>/dev/null | sort -u)

    has_v4=false
    has_v6=false
    port_string=""

    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        ip_hex=${entry%%:*}
        port=${entry#*:}

        # Determine address family from the hex string length
        case ${#ip_hex} in
            8)  # IPv4
                [ "$ip_hex" == "00000000" ] && has_v4=true  # 0.0.0.0
                ;;
            32) # IPv6
                [ "$ip_hex" == "00000000000000000000000000000000" ] && has_v6=true  # ::
                [ "$ip_hex" == "00000000000000000000000001000000" ] && has_v6=true  # ::1
                ;;
        esac

        # Try to find a matching host port mapping
        # Anchor to prevent partial port matches (e.g., 80 vs 8080)
        mapped_port=$(echo " $mappings" | grep -oE " $port/tcp:[0-9]+" | cut -d: -f2 | head -n1)

        label="$(decode_ip "$ip_hex"):$port"
        [ -n "$mapped_port" ] && label="$label(${port}/tcp->${mapped_port})"
        port_string+="$label "
    done < <(printf '%s\n' "$v4_active" "$v6_active")

    # ── Determine overall status ──────────────────────────────
    if [ "$has_v4" = true ] && [ "$has_v6" = true ]; then
        status="D"; color="$PURPLE"; ((dual_count++))
    elif [ "$has_v6" = true ]; then
        status="6"; color="$GREEN"; ((v6_count++))
    elif [ "$has_v4" = true ]; then
        status="4"; color="$BLUE"; ((v4_count++))
    else
        status="✗"; color="$RED"; ((none_count++)); port_string="No listeners"
    fi

    # ── Print row (if not summary‑only) ──────────────────────
    if [ "$SHOW_SUMMARY" = false ]; then
        header=$(printf "${color}[${status}]${NC} %-22s %-12s " "$name" "$net_mode")
        # The port string is plain text; fold and indent continuation lines
        echo "$port_string" | fold -s -w 42 | awk -v h="$header" '
            NR==1 { print h $0 }
            NR>1  { print "                                      " $0 }
        '
    fi

done < <("${PS_CMD[@]}")

# ── Summary (always shown if at least one container is running) ──
if [ "$total_running" -gt 0 ]; then
    capable=$((dual_count + v6_count))
    non_host_count=$((total_running - hostnet_count))
    if [ "$non_host_count" -gt 0 ]; then
        percent=$(( (capable * 100) / non_host_count ))
    else
        percent=0
    fi

    echo -e "\n=== Summary ==="
    echo "Dual-Stack:    $dual_count"
    echo "IPv6-Only:     $v6_count"
    echo "IPv4-Only:     $v4_count"
    echo "No Listeners:  $none_count"
    echo "Host Network:  $hostnet_count  (excluded from IPv6 calc)"
    echo -e "\nIPv6 Capable:  $percent% of non‑host containers"
fi
